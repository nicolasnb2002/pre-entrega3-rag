# Copiá este archivo a .env (cp .env.example .env) y completalo.
# El .env está en .gitignore: NUNCA lo subas a GitHub.
#
# Los EMBEDDINGS no necesitan nada de esto: son locales y gratis.
# Esto es solo para el modelo de lenguaje que redacta la respuesta.
# Sin clave, python rag.py entra en MODO DEMOSTRACIÓN (modelo falso, no llama a nadie).

# openai = usar ChatOpenAI (OpenAI, Gemini o Groq según OPENAI_BASE_URL)
# demo   = forzar el modelo falso aunque haya clave
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
LLM_MAX_TOKENS=2048

# ---------------------------------------------------------------------------
# OPCIÓN RECOMENDADA, GRATIS: Gemini (Google AI Studio)
# Clave: https://aistudio.google.com/apikey
# LLM_PROVIDER=openai
# OPENAI_API_KEY=pegá_acá_la_clave_de_gemini
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_MODEL=gemini-3.5-flash-lite
# LLM_MAX_TOKENS=2048
#
# ALTERNATIVA GRATIS: Groq
# Clave: https://console.groq.com/keys
# LLM_PROVIDER=openai
# OPENAI_API_KEY=pegá_acá_la_clave_de_groq
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=openai/gpt-oss-20b
# LLM_MAX_TOKENS=2048
